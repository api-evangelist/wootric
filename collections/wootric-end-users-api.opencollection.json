{
  "opencollection": "1.0.0",
  "info": {
    "name": "Wootric Declines End Users API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "End Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
